            "type": "cortex-debug",
            "servertype": "openocd",
            "armToolchainPath": "/home/hung/zephyr-sdk-0.17.0/arm-zephyr-eabi/bin",
            "toolchainPrefix": "arm-zephyr-eabi",
            "gdbPath": "/home/hung/zephyr-sdk-0.17.0/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "configFiles": [
                "interface/stlink.cfg",
                "target/nrf51.cfg"
