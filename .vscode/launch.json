            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            }
        },

        {
            "name": "Ground Station",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/Ground_Station/build/zephyr/zephyr.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "gdbPath": "/home/hung/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "objdumpPath": "/home/hung/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
